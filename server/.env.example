# ==============================================================================
# ResolvePay Server Environment Configuration (.env.example)
# Copy this file to .env and provide your local credentials.
# NEVER commit real credentials, passwords, or secrets to version control.
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000

# Client Application URL (used for CORS policy)
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL + Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resolvepay_dev?schema=public"

# Session & Authentication Secret (Generate a strong random string, min 32 chars)
SESSION_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
